<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.liverecorder</groupId>
    <artifactId>LiveRecorder</artifactId>
    <version>1.1.0-ellan</version>
    <packaging>jar</packaging>

    <name>LiveRecorder</name>
    <description>无人机式自由录制者管理系统 - 面向直播/录屏场景的 Minecraft 服务器插件</description>

    <properties>
        <!-- Paper 26.3 is Java 25 bytecode; keep plugin output at Java 8. -->
        <api.groupId>io.papermc.paper</api.groupId>
        <api.artifactId>paper-api</api.artifactId>
        <api.version>26.3.build.157-beta</api.version>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <developers>
        <developer>
            <id>qiyue</id>
            <name>七月</name>
            <organization>七月个人制作组</organization>
            <organizationUrl>https://github.com/httye</organizationUrl>
        </developer>
    </developers>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>${api.groupId}</groupId>
            <artifactId>${api.artifactId}</artifactId>
            <version>${api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.42.0.0</version>
        </dependency>
        
        <!-- 测试依赖 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Original upstream support floor: Spigot/Paper 1.16.5. -->
        <profile>
            <id>legacy-116</id>
            <properties>
                <api.groupId>org.spigotmc</api.groupId>
                <api.artifactId>spigot-api</api.artifactId>
                <api.version>1.16.5-R0.1-SNAPSHOT</api.version>
            </properties>
        </profile>
        <profile>
            <id>paper-263</id>
            <properties>
                <api.groupId>io.papermc.paper</api.groupId>
                <api.artifactId>paper-api</api.artifactId>
                <api.version>26.3.build.157-beta</api.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>LiveRecorder-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
                <executions><execution><id>network-common</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>network-common/src/main/java</source></sources></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
                <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <artifactSet><includes><include>org.xerial:sqlite-jdbc</include></includes></artifactSet>
                    <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter></filters>
                </configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
